{
  "manifest_version": "2",
  "task_list": [
    {
      "name": "Convert Olympus ScanR Plate to OME-Zarr",
      "category": "Conversion",
      "modality": "HCS",
      "tags": [
        "Olympus",
        "ScanR",
        "Plate converter"
      ],
      "docs_info": "### Purpose\n\n- Convert images acquired with an Olympus ScanR microscope to a OME-Zarr Plate.\n\n### Outputs\n\n- A OME-Zarr Plate.\n\n### Limitations\n\n- This task has been tested on a limited set of acquisitions. It may not work on all Olympus ScanR acquisitions.\n\n### Expected inputs\n\nThe following directory structure is expected:\n\n```text\n/plate_dir/\n----/data/\n--------/metadata.ome.xml\n--------/B2--W00014--P00001--Z00000--T00000--DAPi.tif\n--------/B2--W00014--P00001--Z00000--T00000--TRITC.tif\n--------/...\n```\n",
      "type": "converter_compound",
      "executable_non_parallel": "olympus_scanr/convert_scanr_init_task.py",
      "executable_parallel": "olympus_scanr/convert_scanr_compute_task.py",
      "meta_non_parallel": {
        "cpus_per_task": 1,
        "mem": 4000
      },
      "meta_parallel": {
        "cpus_per_task": 1,
        "mem": 12000
      },
      "args_schema_non_parallel": {
        "$defs": {
          "AcquisitionInputModel": {
            "description": "Acquisition metadata.",
            "properties": {
              "path": {
                "title": "Path",
                "type": "string",
                "description": "Path to the acquisition directory. For scanr, this should include a 'data/' directory with the tiff files and a metadata.ome.xml file."
              },
              "plate_name": {
                "title": "Plate Name",
                "type": "string",
                "description": "Optional custom name for the plate. If not provided, the name will be the acquisition directory name."
              },
              "acquisition_id": {
                "default": 0,
                "minimum": 0,
                "title": "Acquisition Id",
                "type": "integer",
                "description": "Acquisition ID, used to identify the acquisition in case of multiple acquisitions."
              },
              "layout": {
                "default": "96-well",
                "enum": [
                  "24-well",
                  "48-well",
                  "96-well",
                  "384-well"
                ],
                "title": "Layout",
                "type": "string",
                "description": "Plate layout type."
              },
              "advanced": {
                "$ref": "#/$defs/AdvancedAcquisitionOptions",
                "default": {
                  "channels": null,
                  "pixel_info": null
                },
                "title": "Advanced",
                "description": "Advanced acquisition options."
              }
            },
            "required": [
              "path",
              "plate_name"
            ],
            "title": "AcquisitionInputModel",
            "type": "object"
          },
          "AdvancedAcquisitionOptions": {
            "description": "Advanced acquisition options.",
            "properties": {
              "channels": {
                "items": {
                  "$ref": "#/$defs/ChannelInfo"
                },
                "title": "Channels",
                "type": "array"
              },
              "pixel_info": {
                "$ref": "#/$defs/PixelSizeModel",
                "title": "Pixel_Info"
              }
            },
            "title": "AdvancedAcquisitionOptions",
            "type": "object"
          },
          "AlignmentCorrections": {
            "additionalProperties": false,
            "properties": {
              "align_xy": {
                "default": false,
                "title": "Align Xy",
                "type": "boolean"
              },
              "align_z": {
                "default": false,
                "title": "Align Z",
                "type": "boolean"
              },
              "align_t": {
                "default": false,
                "title": "Align T",
                "type": "boolean"
              }
            },
            "title": "AlignmentCorrections",
            "type": "object",
            "description": "Missing description for AlignmentCorrections."
          },
          "BackendType": {
            "enum": [
              "anndata",
              "json",
              "csv",
              "parquet"
            ],
            "title": "BackendType",
            "type": "string",
            "description": "Missing description for BackendType."
          },
          "ChannelInfo": {
            "description": "Channel information.",
            "properties": {
              "name": {
                "title": "Name",
                "type": "string"
              },
              "wavelength_id": {
                "title": "Wavelength Id",
                "type": "string"
              },
              "colors": {
                "title": "Colors",
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "title": "ChannelInfo",
            "type": "object"
          },
          "ConverterOptions": {
            "additionalProperties": false,
            "properties": {
              "tiling_mode": {
                "$ref": "#/$defs/TilingMode",
                "default": "Auto",
                "title": "Tiling_Mode"
              },
              "stage_correction": {
                "$ref": "#/$defs/StageCorrections",
                "title": "Stage_Correction"
              },
              "alignment_correction": {
                "$ref": "#/$defs/AlignmentCorrections",
                "title": "Alignment_Correction"
              },
              "omezarr_options": {
                "$ref": "#/$defs/OmeZarrOptions",
                "title": "Omezarr_Options"
              }
            },
            "title": "ConverterOptions",
            "type": "object",
            "description": "Missing description for ConverterOptions."
          },
          "OmeZarrOptions": {
            "additionalProperties": false,
            "properties": {
              "num_levels": {
                "default": 5,
                "minimum": 1,
                "title": "Num Levels",
                "type": "integer"
              },
              "max_xy_chunk": {
                "default": 4096,
                "minimum": 1,
                "title": "Max Xy Chunk",
                "type": "integer"
              },
              "z_chunk": {
                "default": 10,
                "minimum": 1,
                "title": "Z Chunk",
                "type": "integer"
              },
              "c_chunk": {
                "default": 1,
                "minimum": 1,
                "title": "C Chunk",
                "type": "integer"
              },
              "t_chunk": {
                "default": 1,
                "minimum": 1,
                "title": "T Chunk",
                "type": "integer"
              },
              "ngff_version": {
                "default": "0.4",
                "enum": [
                  "0.4",
                  "0.5"
                ],
                "title": "Ngff Version",
                "type": "string"
              },
              "table_backend": {
                "$ref": "#/$defs/BackendType",
                "default": "anndata",
                "title": "Table_Backend"
              }
            },
            "title": "OmeZarrOptions",
            "type": "object",
            "description": "Missing description for OmeZarrOptions."
          },
          "OverwriteMode": {
            "enum": [
              "No Overwrite",
              "Overwrite",
              "Extend"
            ],
            "title": "OverwriteMode",
            "type": "string",
            "description": "Missing description for OverwriteMode."
          },
          "PixelSizeModel": {
            "description": "Pixel size model 2.",
            "properties": {
              "pixelsize": {
                "title": "Pixelsize",
                "type": "number"
              },
              "z_spacing": {
                "title": "Z Spacing",
                "type": "number"
              },
              "t_spacing": {
                "title": "T Spacing",
                "type": "number"
              }
            },
            "required": [
              "pixelsize",
              "z_spacing",
              "t_spacing"
            ],
            "title": "PixelSizeModel",
            "type": "object"
          },
          "StageCorrections": {
            "additionalProperties": false,
            "properties": {
              "flip_x": {
                "default": false,
                "title": "Flip X",
                "type": "boolean"
              },
              "flip_y": {
                "default": false,
                "title": "Flip Y",
                "type": "boolean"
              },
              "swap_xy": {
                "default": false,
                "title": "Swap Xy",
                "type": "boolean"
              }
            },
            "title": "StageCorrections",
            "type": "object",
            "description": "Missing description for StageCorrections."
          },
          "TilingMode": {
            "enum": [
              "Auto",
              "Snap to Grid",
              "Snap to Corners",
              "Inplace",
              "No Tiling"
            ],
            "title": "TilingMode",
            "type": "string",
            "description": "Missing description for TilingMode."
          }
        },
        "additionalProperties": false,
        "properties": {
          "zarr_dir": {
            "title": "Zarr Dir",
            "type": "string",
            "description": "Directory to store the Zarr files."
          },
          "acquisitions": {
            "items": {
              "$ref": "#/$defs/AcquisitionInputModel"
            },
            "title": "Acquisitions",
            "type": "array",
            "description": "List of raw acquisitions to convert to OME-Zarr."
          },
          "overwrite": {
            "$ref": "#/$defs/OverwriteMode",
            "default": "No Overwrite",
            "title": "Overwrite",
            "description": "Overwrite mode for existing data. - \"No Overwrite\": Do not overwrite existing data. - \"Overwrite\": Remove and replace existing data. - \"Extend\": Extend existing data without removing it. Default is \"No Overwrite\"."
          },
          "converter_options": {
            "$ref": "#/$defs/ConverterOptions",
            "default": {
              "tiling_mode": "Auto",
              "stage_correction": {
                "flip_x": false,
                "flip_y": false,
                "swap_xy": false
              },
              "alignment_correction": {
                "align_t": false,
                "align_xy": false,
                "align_z": false
              },
              "omezarr_options": {
                "c_chunk": 1,
                "max_xy_chunk": 4096,
                "ngff_version": "0.4",
                "num_levels": 5,
                "t_chunk": 1,
                "table_backend": "anndata",
                "z_chunk": 10
              }
            },
            "title": "Converter Options",
            "description": "Advanced converter options."
          }
        },
        "required": [
          "zarr_dir",
          "acquisitions"
        ],
        "type": "object",
        "title": "ConvertScanrInitTask"
      },
